# ==============================================================================
# Competitor Watch Environment Configuration Template
# Copy this file to .env and insert your API keys / webhooks.
# DO NOT commit your actual .env file to version control.
# ==============================================================================

# LLM Providers (Pick at least one; falls back to heuristic rules if neither is set)
# 1. Google Gemini (free key from https://aistudio.google.com - uses Python standard library)
GEMINI_API_KEY=

# 2. Anthropic Claude (paid; requires `pip install anthropic`)
ANTHROPIC_API_KEY=

# Optional model overrides:
# GEMINI_MODEL=gemini-flash-latest
# WATCH_MODEL=claude-sonnet-5-5

# Optional Slack integration (posts top signals to a designated Slack channel)
SLACK_WEBHOOK_URL=
